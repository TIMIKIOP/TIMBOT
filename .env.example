OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
POSTGRES_DB=timbot
POSTGRES_USER=timbot
POSTGRES_PASSWORD=replace-with-a-local-development-password
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
